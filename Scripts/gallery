#!/bin/bash
# gallery — build the gallery, wrap it in a minimal .app bundle, and open it.
#
#   Scripts/gallery                          open the gallery
#   Scripts/gallery --entry Button           …straight onto one entry
#   Scripts/gallery --entry Button --theme dark
#
# WHY A BUNDLE, not just `swift run TrembusGallery`:
#   · a bare executable has no bundle identifier, so it gets no proper name in the Dock or
#     menu bar, and tools that address apps by identifier (Accessibility Inspector,
#     screen-driving agents) cannot see it at all
#   · `open` detaches the app, so this command returns instead of holding the terminal hostage
#   · re-running it replaces the running copy, so you always look at the code you just built
set -euo pipefail
cd "$(dirname "$0")/.."

BUNDLE_ID="com.trembus.gallery"
Scripts/swiftw build --product TrembusGallery
BIN_DIR="$(Scripts/swiftw build --show-bin-path)"
APP="$BIN_DIR/TrembusGallery.app"

# Quit a copy that is already running, so the new build is the one you see.
osascript -e "tell application id \"$BUNDLE_ID\" to quit" >/dev/null 2>&1 || true
pkill -f "TrembusGallery.app/Contents/MacOS/TrembusGallery" >/dev/null 2>&1 || true

rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS"
cp "$BIN_DIR/TrembusGallery" "$APP/Contents/MacOS/TrembusGallery"
cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>$BUNDLE_ID</string>
    <key>CFBundleName</key><string>Trembus Gallery</string>
    <key>CFBundleDisplayName</key><string>Trembus Gallery</string>
    <key>CFBundleExecutable</key><string>TrembusGallery</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSMinimumSystemVersion</key><string>15.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
</dict>
</plist>
PLIST
# Ad-hoc signature over the whole bundle (local only — nothing is notarized or distributed).
# Don't both suppress stderr AND let `set -e` abort silently: say what failed.
codesign --force --sign - "$APP" >/dev/null || { echo "gallery: codesign failed" >&2; exit 1; }

open -n "$APP" --args "$@"
echo "opened Trembus Gallery  ($BUNDLE_ID)"
